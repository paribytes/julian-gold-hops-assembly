#!/bin/bash

# PBS job: MaSuRCA assembly for JG2 on ram512

#PBS -N julian_gold2
#PBS -l nodes=1:r512:ppn=20
#PBS -l walltime=900:00:00
#PBS -j oe
#PBS -o masurca_JG2.log

BASE_DIR=/sdm/scratch/priyanshi/julian_gold_assembly  
cd $BASE_DIR

source ~/.bashrc
mamba activate masurca

echo "Starting MaSuRCA assembly for JG2 on $(hostname)"

mkdir -p ${BASE_DIR}/JG2_assembly
cd ${BASE_DIR}/JG2_assembly

ln -sf ${BASE_DIR}/masurca_config_JG2.txt .

masurca masurca_config_JG2.txt
chmod +x assemble.sh
./assemble.sh

echo "Finished MaSuRCA assembly for JG2"
echo "Final assembly should be at: JG2_assembly/CA/*.fasta"
echo "(check assemble.sh output for exact final name, usually final.genome.scf.fasta)"
