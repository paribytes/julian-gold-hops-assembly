#!/bin/bash

#PBS -N julian_gold3_rt
#PBS -l nodes=1:node21:ppn=16
#PBS -l walltime=900:00:00
#PBS -j oe
#PBS -o ragtag_JG3_scaffold2.log

BASE_DIR=/usr/scratch/priyanshi/julian_gold_assembly
cd $BASE_DIR

source ~/.bashrc
mamba activate ragtag

# Same reference used for the correct step
REFERENCE=/sdm/scratch/priyanshi/RefHopsGenomeHudAl/Humulus_lupulus_lupulus_21110M_HAP2_v1.0.fa

CORRECTED_FASTA=${BASE_DIR}/JG3_ragtag/correct/ragtag.correct.fasta

if [ ! -f "$CORRECTED_FASTA" ]; then
    echo "ERROR: could not find $CORRECTED_FASTA - correct step output missing"
    exit 1
fi

# Remove the old failed scaffold output before rerunning, so RagTag doesn't get confused by partial/stale files from the crashed attempt
rm -rf ${BASE_DIR}/JG3_ragtag/scaffold

echo "Running ragtag scaffold for JG3 (retry after pysam patch) ..."
ragtag.py scaffold \
    $REFERENCE \
    $CORRECTED_FASTA \
    -o ${BASE_DIR}/JG3_ragtag/scaffold \
    -t 16

echo "Done. Final scaffolded assembly for JG3:"
echo "  ${BASE_DIR}/JG3_ragtag/scaffold/ragtag.scaffold.fasta"
echo "Scaffolding stats/confidence scores:"
echo "  ${BASE_DIR}/JG3_ragtag/scaffold/ragtag.scaffold.stats"
