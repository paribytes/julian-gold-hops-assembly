#!/bin/bash
# ==========================================================================
# PBS job: MaSuRCA assembly for JG3 on the high-memory ram2tb node
# Submit with:  qsub 06_run_masurca_JG3_ramnode.pbs
#
# Using ram2tb (not ram15tb) so JG3 runs in parallel with JG2, rather than
# both queueing for the same single r15tb node one after another.
# ==========================================================================
#PBS -N julian_gold3
#PBS -l nodes=1:node21:ppn=24
#PBS -l walltime=900:00:00
#PBS -j oe
#PBS -o masurca_JG3.log

BASE_DIR=/sdm/scratch/priyanshi/julian_gold_assembly 
cd $BASE_DIR

source ~/.bashrc
mamba activate masurca

echo "Starting MaSuRCA assembly for JG3 on $(hostname)"

mkdir -p ${BASE_DIR}/JG3_assembly
cd ${BASE_DIR}/JG3_assembly

ln -sf ${BASE_DIR}/masurca_config_JG3.txt .

masurca masurca_config_JG3.txt
chmod +x assemble.sh
./assemble.sh

echo "Finished MaSuRCA assembly for JG3"
echo "Final assembly should be at: JG3_assembly/CA/*.fasta"
echo "(check assemble.sh output for exact final name, usually final.genome.scf.fasta)"
